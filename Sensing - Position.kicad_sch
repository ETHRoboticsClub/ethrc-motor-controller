			)
			(justify left top)
		)
		(uuid "99e3acc9-7ae3-4798-8811-cb8a74a42a1f")
	)
	(text_box "LAYOUT NOTE: SENSOR PORTS\n* U8/U9/U11 right at J5/J6: route each line over its IO pad and out of the twin FT pad.\n* Hall 1 nF and NTC 100 nF caps at the MCU end of the series resistors."
		(exclude_from_sim no)
		(at 142.24 180.34 0)
		(size 110 21.59)
