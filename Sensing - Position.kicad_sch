	(text_box "LAYOUT NOTE: ENCODER\n* U7 centred on the motor axis, 8x3 mm diametric magnet at ~2 mm air gap.\n* No ferrous parts or large current loops near U7; C64/C65 at the pins."
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(size 110 21.59)
		(margins 2.25 2.25 2.25 2.25)
