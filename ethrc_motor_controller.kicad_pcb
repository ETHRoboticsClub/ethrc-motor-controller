(kicad_pcb
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(general
		(thickness 1.535)
		(legacy_teardrops yes)
	)
	(paper "A4")
	(title_block
		(date "2024-04-13")
		(rev "${REVISION}")
		(company "${COMPANY}")
	)
	(layers
		(0 "F.Cu" signal "L1 (Sig, PWR)")
		(4 "In1.Cu" power "L2 (GND)")
		(6 "In2.Cu" signal "L3 (Sig, PWR)")
		(8 "In3.Cu" signal "L4 (Sig, PWR)")
		(10 "In4.Cu" power "L5 (GND)")
		(2 "B.Cu" signal "L6 (Sig, PWR)")
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
		(5 "F.SilkS" user "F.Silkscreen")
		(7 "B.SilkS" user "B.Silkscreen")
		(1 "F.Mask" user)
		(3 "B.Mask" user)
		(17 "Dwgs.User" user "TitlePage")
		(19 "Cmts.User" user "User.Comments")
		(21 "Eco1.User" user "F.DNP")
		(23 "Eco2.User" user "B.DNP")
		(25 "Edge.Cuts" user)
		(27 "Margin" user)
		(31 "F.CrtYd" user "F.Courtyard")
		(29 "B.CrtYd" user "B.Courtyard")
		(35 "F.Fab" user)
		(33 "B.Fab" user)
		(39 "User.1" user "DrillMap")
		(41 "User.2" user "F.TestPoint")
		(43 "User.3" user "B.TestPoint")
		(45 "User.4" user "F.AssemblyText")
		(47 "User.5" user "B.AssemblyText")
		(49 "User.6" user "F.Dimensions")
		(51 "User.7" user "B.Dimensions")
		(53 "User.8" user "F.TestPointList")
		(55 "User.9" user "B.TestPointList")
	)
	(setup
		(stackup
			(layer "F.SilkS"
				(type "Top Silk Screen")
				(color "Yellow")
				(material "Direct Printing")
			)
			(layer "F.Paste"
				(type "Top Solder Paste")
			)
			(layer "F.Mask"
				(type "Top Solder Mask")
				(color "Green")
				(thickness 0.02)
				(material "Solder Resist")
				(epsilon_r 3.3)
				(loss_tangent 0)
			)
			(layer "F.Cu"
				(type "copper")
				(thickness 0.0525)
			)
			(layer "dielectric 1"
				(type "prepreg")
				(color "FR4 natural")
				(thickness 0.13)
				(material "FR4_7628")
				(epsilon_r 4.45)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 2"
				(type "core")
				(color "FR4 natural")
				(thickness 0.43)
				(material "FR4")
				(epsilon_r 4.6)
				(loss_tangent 0.02)
			)
			(layer "In2.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 3"
				(type "prepreg")
				(color "FR4 natural")
				(thickness 0.13)
				(material "FR4_7628")
				(epsilon_r 4.45)
				(loss_tangent 0.02)
			)
			(layer "In3.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 4"
				(type "core")
				(color "FR4 natural")
				(thickness 0.43)
				(material "FR4")
				(epsilon_r 4.6)
				(loss_tangent 0.02)
			)
			(layer "In4.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 5"
				(type "prepreg")
				(color "FR4 natural")
				(thickness 0.13)
				(material "FR4_7628")
				(epsilon_r 4.29)
				(loss_tangent 0.02)
			)
			(layer "B.Cu"
				(type "copper")
				(thickness 0.0525)
			)
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(color "Green")
				(thickness 0.02)
				(material "Solder Resist")
				(epsilon_r 3.3)
				(loss_tangent 0)
			)
			(layer "B.Paste"
				(type "Bottom Solder Paste")
			)
			(layer "B.SilkS"
				(type "Bottom Silk Screen")
				(color "Yellow")
				(material "Direct Printing")
			)
			(copper_finish "Immersion gold")
			(dielectric_constraints yes)
		)
		(pad_to_mask_clearance 0.05)
		(allow_soldermask_bridges_in_footprints no)
		(tenting front back)
		(aux_axis_origin 113.5 125)
		(pcbplotparams
			(layerselection 0x00000000_00000000_55555555_5755f5ff)
			(plot_on_all_layers_selection 0x00000000_00000000_00000000_00000000)
			(disableapertmacros no)
			(usegerberextensions no)
			(usegerberattributes yes)
			(usegerberadvancedattributes yes)
			(creategerberjobfile no)
			(dashed_line_dash_ratio 12.000000)
			(dashed_line_gap_ratio 3.000000)
			(svgprecision 4)
			(plotframeref no)
			(mode 1)
			(useauxorigin no)
			(hpglpennumber 1)
			(hpglpenspeed 20)
			(hpglpendiameter 15.000000)
			(pdf_front_fp_property_popups yes)
			(pdf_back_fp_property_popups yes)
			(pdf_metadata yes)
			(pdf_single_document no)
			(dxfpolygonmode yes)
			(dxfimperialunits yes)
			(dxfusepcbnewfont yes)
			(psnegative no)
			(psa4output no)
			(plot_black_and_white yes)
			(sketchpadsonfab no)
			(plotpadnumbers no)
			(hidednponfab no)
			(sketchdnponfab yes)
			(crossoutdnponfab yes)
			(subtractmaskfromsilk yes)
			(outputformat 1)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "Manufacturing/Fabrication/Gerbers/")
		)
	)
	(property "ASSEMBLY_NOTES" "")
	(property "BOARD_NAME" "ETHRC Motor Controller")
	(property "COMPANY" "ETH Robotics Club")
	(property "DESIGNER" "Masiar Etemadi")
	(property "FABRICATION_NOTES" "")
	(property "GIT_HASH_PCB" "5f4aed2")
	(property "GIT_HASH_SCH" "1a83c5d")
	(property "GIT_URL" "https://github.com/ETHRoboticsClub/ethrc-motor-controller")
	(property "PROJECT_NAME" "BLDC Motor Controller")
	(property "RELEASE_BODY_1.0.0" "___________________________________\n\nAdded\n\n-   TVS protection and termination switch to FD-CAN.\n\n-   Low-side switched 12V 600 mA source for external fan.\n\n-   LDO for analog supply.\n\n-   One TVS diode per power connector.\n\n-   Second on-board I2C magnetic encoder for disambiguation.\n\n-   ESD protection to all interfaces.\n\n-   Over-voltage protection on thermistor ADC inputs.\n\n-   Pi filters to inputs of buck regulators and MCU analog supply.\n\n-   Decoupling caps next to power pins of connectors.\n\n___________________________________\n\nChanged\n\n-   CPH-CPL capacitor to 47 nF (gate driver).\n\n-   FD-CAN transceiver IC.\n\n-   FETs for top cooled variant.\n\n-   Input power TVS diode to bidirectional.\n\n-   Moved SOx low-pass filter to MCU section.\n\n-   PWM_PHASEA with PWM_PHASEC on STM32G474 pinout for easier routing.\n\n-   RS422 pinout on connector.\n\n-   Buck regulators to optimize for low noise.")
	(property "RELEASE_BODY_1.0.1" "___________________________________\n\nAdded\n\n-   Controller target specifications.\n\n-   Credits to moteus on cover page.\n\n-   Optional RC-Snubber to power stage.\n\n___________________________________\n\nFixed\n\n-   Chassis guard ring to go around the board.\n\n-   CAN and power TVS diodes now go to chassis.\n\n-   Clearance between nets to respect IEC60664-1 where possible.\n\n-   Comment on precharge.\n\n-   Power TVS diode reference designator from \"U\" to \"D\".\n\n___________________________________\n\nChanged\n\n-   5V 300 mA buck converter with 600 mA version.\n\n-   Chassis-GND capacitor by 1nF 1kV.")
	(property "RELEASE_BODY_1.0.2" "___________________________________\n\nChanged\n\n-   Power sequencing graph according to experimental data.")
	(property "RELEASE_BODY_1.1.0" "___________________________________\n\nAdded\n\n-   RC snubber passive values.\n\n___________________________________\n\nFixed\n\n-   More vias for VBUS and LMR36006 GND pads.\n\n-   Board version voltage reference from +3V3 to +A3V3.\n\n___________________________________\n\nChanged\n\n-   Motor thermistor resistor divider to 2kOhm for a 10k 3950K thermistor.")
	(property "RELEASE_BODY_1.1.1" "___________________________________\n\nFixed\n\n-   Replace non-stocked components.")
	(property "RELEASE_BODY_UNRELEASED" "Version Unreleased not found.")
	(property "RELEASE_DATE" "08-Nov-2026")
	(property "RELEASE_DATE_NUM" "2026-11-08")
	(property "RELEASE_TITLE_1.0.0" "Version 1.0.0 - 2023-12-12")
	(property "RELEASE_TITLE_1.0.1" "Version 1.0.1 - 2024-01-25")
	(property "RELEASE_TITLE_1.0.2" "Version 1.0.2 - 2024-03-12")
	(property "RELEASE_TITLE_1.1.0" "Version 1.1.0 - 2024-04-13")
	(property "RELEASE_TITLE_1.1.1" "Version 1.1.1 - 2025-01-18")
	(property "RELEASE_TITLE_UNRELEASED" "Version Unreleased not found.")
